# Webhook de entrada do Bitrix24 (Aplicativos > Desenvolvedor > Webhook de entrada).
# Dá acesso total ao portal: trate como senha, nunca comite.
BITRIX_WEBHOOK=https://seuportal.bitrix24.com.br/rest/1/COLE_O_TOKEN_AQUI/

# Timeout de socket, em segundos.
BITRIX_TIMEOUT=30

# Balde furado local. O padrao do portal e 50 operacoes vazando 2/s.
# Planos maiores aguentam mais; medir antes de aumentar.
BITRIX_BUCKET_CAPACITY=50
BITRIX_BUCKET_RATE=2
